PORT=5002
MONGODB_URI=mongodb://127.0.0.1:27017/amour_hotel
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://127.0.0.1:5500

# Optional SSLCommerz sandbox integration (demo payment works without these)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# ---- EmailJS (server-side REST API) ----
# Dashboard: https://dashboard.emailjs.com/
# Account -> Security -> enable "Allow EmailJS API for non-browser applications"
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_FROM_NAME=Amour Hotel
EMAILJS_REPLY_TO=
# Template ids (BOOKING is used as the fallback for the others)
EMAILJS_TEMPLATE_BOOKING=
EMAILJS_TEMPLATE_WELCOME=
EMAILJS_TEMPLATE_CANCELLED=
EMAILJS_TEMPLATE_PAYMENT=
